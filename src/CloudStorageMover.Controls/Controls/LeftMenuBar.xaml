<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CloudStorageMover.Controls.Controls.LeftMenuBar"
             x:Name="menuBar"
             >
    <Border BackgroundColor="#1f1f1f"
            StrokeThickness="0"
            WidthRequest="60"
            VerticalOptions="Fill">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
              Padding="0"
              RowSpacing="0">

            <Border Grid.Row="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0"
                    HeightRequest="64"
                    WidthRequest="60">
                <Label Text="☰"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Button Grid.Row="1"
                    x:Name="SourceButton"
                    Text="📁"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="OnSourceClicked" />

            <Button Grid.Row="2"
                    x:Name="PhotosPickerButton"
                    Text="📷"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="OnPhotosPickerClicked" />

            <Button Grid.Row="3"
                    x:Name="GalleryButton"
                    Text="🖼"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="OnGalleryClicked" />

            <Button Grid.Row="4"
                    x:Name="CameraImportButton"
                    Text="🎞"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="OnCameraImportClicked" />

            <Button Grid.Row="5"
                    x:Name="TransferButton"
                    Text="⬇"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="0"
                    Padding="0"
                    Clicked="OnTransferClicked" />

            <VerticalStackLayout Grid.Row="6"
                                 VerticalOptions="End"
                                 Spacing="0">
                <Button x:Name="ConfigButton"
                        Text="⚙️"
                        FontSize="22"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        WidthRequest="60"
                        HeightRequest="60"
                        CornerRadius="0"
                        Padding="0"
                        Clicked="OnConfigClicked" />

                <Button x:Name="QuitButton"
                        Text="⏻"
                        FontSize="22"
                        BackgroundColor="Transparent"
                        TextColor="#e74c3c"
                        WidthRequest="60"
                        HeightRequest="60"
                        CornerRadius="0"
                        Padding="0"
                        Clicked="OnQuitClicked" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
