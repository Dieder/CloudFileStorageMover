<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CloudStorageMover.Controls.Controls.FolderPanel"
             x:Name="folderPanel">
    <Border BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#252525}"
            StrokeThickness="0"
            WidthRequest="220"
            VerticalOptions="Fill">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="0">
            <Border Grid.Row="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="12,10">
                <Label Text="Folders"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333, Dark=#ccc}" />
            </Border>
            <BoxView Grid.Row="0"
                     HeightRequest="1"
                     Color="#333333"
                     VerticalOptions="End" />
            <CollectionView Grid.Row="1"
                            x:Name="FolderList"
                            SelectionMode="Single"
                            SelectionChanged="OnFolderSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="📁"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#1f1f1f, Dark=#e0e0e0}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Select a source"
                           FontSize="13"
                           TextColor="#888"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="20" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </Border>
</ContentView>
