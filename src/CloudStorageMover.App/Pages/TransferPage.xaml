<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CloudStorageMover.App.ViewModels"
             x:Class="CloudStorageMover.App.Pages.TransferPage"
             x:DataType="vm:TransferViewModel"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="20,15"
              BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2a2a2a}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="⬇"
                   FontSize="24"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="Transfer Files"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#333, Dark=#EEE}"
                   Margin="10,0,0,0"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="{Binding SelectedFilesSummary}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#666, Dark=#aaa}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Content area (scrollable) -->
        <ScrollView Grid.Row="1"
                    Padding="20">
            <VerticalStackLayout Spacing="15">

                <!-- Empty state -->
                <Border IsVisible="{Binding SelectedFilesCount, Converter={StaticResource NotZeroConverter}}"
                        BackgroundColor="#FFF3CD"
                        Padding="15,10"
                        StrokeThickness="0">
                    <Label Text="No files selected. Go to Source, enable Multi-select, and select files to transfer."
                           TextColor="#856404"
                           FontSize="13" />
                </Border>

                <!-- Destination selection -->
                <VerticalStackLayout IsVisible="{Binding IsDestinationVisible}"
                                     Spacing="15">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="Select destination:"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#EEE}"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="← Back"
                                BackgroundColor="#555"
                                TextColor="White"
                                CornerRadius="8"
                                Padding="12,8"
                                FontSize="13"
                                Command="{Binding BackToSourceCommand}"
                                VerticalOptions="Center" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Destinations}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DestinationItem">
                                <Border Padding="15,12"
                                        Margin="0,0,0,8"
                                        Stroke="{AppThemeBinding Light=#ddd, Dark=#444}"
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2a2a2a}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="12">
                                        <!-- Radio indicator -->
                                        <Border Grid.Column="0"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                Stroke="{AppThemeBinding Light=#999, Dark=#666}"
                                                StrokeThickness="2"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransferViewModel}}, Path=SelectDestinationCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <!-- Filled circle when selected -->
                                            <Border IsVisible="{Binding IsSelected}"
                                                    WidthRequest="12"
                                                    HeightRequest="12"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#512BD4"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                            </Border>
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="{Binding DisplayLabel}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light=#333, Dark=#EEE}"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2"
                                               Text="{Binding IsRemovable, Converter={StaticResource BoolToStringConverter}}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#888, Dark=#aaa}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Select Destination Folder..."
                            Clicked="OnDestinationSelected"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="20,12"
                            FontSize="14"
                            HorizontalOptions="Start" />

                    <!-- Transfer button (visible when destination is selected AND files exist) -->
                    <Border IsVisible="{Binding HasSelectedDestination}"
                            BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1a3a1c}"
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding SelectedDestinationSummary}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#155724, Dark=#A5D6A7}" />
                                <Label Text="{Binding SelectedFilesSummary}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#333, Dark=#CCC}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Transfer Files"
                                    BackgroundColor="#27ae60"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Padding="16,10"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Clicked="OnExecuteTransfer"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
