<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CloudStorageMover.App"
             xmlns:converters="clr-namespace:CloudStorageMover.App.Converters"
             x:Class="CloudStorageMover.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NotZeroConverter x:Key="NotZeroConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter"
                                               TrueValue="USB"
                                               FalseValue="Local" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:MultiSelectConverter x:Key="MultiSelectConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
