<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CloudStorageMover.Controls.Controls;assembly=CloudStorageMover.Controls"
             x:Class="CloudStorageMover.App.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">
    <Grid ColumnDefinitions="60,Auto,*"
          ColumnSpacing="0">

        <controls:LeftMenuBar Grid.Column="0"
                              x:Name="MenuBar" />

        <BoxView Grid.Column="1"
                 WidthRequest="1"
                 Color="#333333"
                 VerticalOptions="Fill" />

        <ContentView Grid.Column="2"
                     x:Name="ContentArea" />
    </Grid>
</ContentPage>
