<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CloudStorageMover.Controls.Controls;assembly=CloudStorageMover.Controls"
             x:Class="CloudStorageMover.App.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">
    <Grid ColumnDefinitions="60,Auto,Auto,Auto,*"
          ColumnSpacing="0">

        <!-- Zone 1: Left Icon Menu -->
        <controls:LeftMenuBar Grid.Column="0"
                              x:Name="MenuBar" />

        <!-- Separator 1 -->
        <BoxView Grid.Column="1"
                 WidthRequest="1"
                 Color="#333333"
                 VerticalOptions="Fill" />

        <!-- Zone 2: Folder Panel -->
        <controls:FolderPanel Grid.Column="2"
                              x:Name="FolderPanel"
                              IsVisible="{Binding IsFolderPanelVisible}"
                              Folders="{Binding CurrentFolders}" />

        <!-- Separator 2 (visible when folder panel is visible) -->
        <BoxView Grid.Column="3"
                 WidthRequest="1"
                 Color="#333333"
                 VerticalOptions="Fill" />

        <!-- Zone 3+4+5: Content Area -->
        <ContentView Grid.Column="4"
                     x:Name="ContentArea" />
    </Grid>
</ContentPage>
