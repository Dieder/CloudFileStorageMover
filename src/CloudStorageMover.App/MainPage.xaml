<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CloudStorageMover.Controls.Controls;assembly=CloudStorageMover.Controls"
             x:Class="CloudStorageMover.App.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1f1f1f}">
    <Grid ColumnDefinitions="60,Auto,*,Auto,60"
          RowDefinitions="Auto,*,Auto"
          ColumnSpacing="0"
          RowSpacing="0">

        <!-- Zone 1: Left Icon Menu -->
        <controls:LeftMenuBar Grid.Column="0"
                              Grid.RowSpan="3"
                              x:Name="MenuBar" />

        <!-- Separator 1 -->
        <BoxView Grid.Column="1"
                 Grid.RowSpan="3"
                 WidthRequest="1"
                 Color="#333333"
                 VerticalOptions="Fill" />

        <!-- Zone 2: Source Selection / File Explorer -->
        <ContentView Grid.Column="2"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      x:Name="SourceSelectionArea"
                      IsVisible="{Binding IsSourcePageVisible}}" />

        <!-- Separator 2 -->
        <BoxView Grid.Column="3"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 WidthRequest="1"
                 Color="#333333"
                 VerticalOptions="Fill" />

        <!-- Zone 4: File Browser (shows when IsFileBrowserVisible) -->
        <ContentView Grid.Column="2"
                     Grid.Row="1"
                     Grid.ColumnSpan="3"
                     x:Name="FileBrowserArea"
                     IsVisible="{Binding IsFileBrowserVisible}}" />

        <!-- Zone 6: Configuration Page -->
        <ContentView Grid.Column="2"
                     Grid.Row="0"
                     Grid.RowSpan="2"
                     Grid.ColumnSpan="3"
                     x:Name="ConfigArea"
                     IsVisible="{Binding IsConfigPageVisible}}" />

        <!-- Zone 7: Photo Gallery Page -->
        <ContentView Grid.Column="2"
                     Grid.Row="0"
                     Grid.RowSpan="2"
                     Grid.ColumnSpan="3"
                     x:Name="GalleryArea"
                     IsVisible="{Binding IsGalleryPageVisible}}" />

        <!-- Zone 8: Camera Import Page -->
        <ContentView Grid.Column="2"
                     Grid.Row="0"
                     Grid.RowSpan="2"
                     Grid.ColumnSpan="3"
                     x:Name="CameraImportArea"
                     IsVisible="{Binding IsCameraImportPageVisible}}" />

        <!-- Separator 3 -->
        <BoxView Grid.Column="0"
                 Grid.ColumnSpan="5"
                 Grid.Row="2"
                 HeightRequest="1"
                 Color="#333333"
                 HorizontalOptions="Fill" />

        <!-- Zone 5: Bottom Action Bar -->
        <Grid Grid.Column="0"
              Grid.ColumnSpan="5"
              Grid.Row="2"
              BackgroundColor="#ffffff">
            <Button Grid.Column="3"
                    Grid.Row="0"
                    Text="Transfer"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,12"
                    FontSize="14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Command="{Binding TransferSelectedFilesCommand}" />
        </Grid>
    </Grid>
</ContentPage>
