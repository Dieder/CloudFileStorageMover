<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CloudStorageMover.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CloudStorageMover.App"
    xmlns:pages="clr-namespace:CloudStorageMover.App.Pages"
    Title="CloudStorageMover.App">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Album Manager"
        ContentTemplate="{DataTemplate pages:AlbumManagerPage}"
        Route="AlbumManagerPage"
        Shell.TabBarIsVisible="False" />

</Shell>
