<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FileMover.UI.ViewModels"
             x:Class="FileMover.UI.Pages.CredentialsConfigPage"
             Title="Credentials">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Provider Selection -->
            <Label Text="Select Provider"
                   FontSize="16"
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding ConfigurableProviders}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedProvider}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConfigurableProvider">
                        <Frame BorderColor="#E0E0E0"
                               CornerRadius="8"
                               Padding="15"
                               Margin="0,3"
                               HasShadow="True">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="✓ Configured"
                                       FontSize="12"
                                       TextColor="Green"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsConfigured}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Credential Fields -->
            <Frame BorderColor="#D0D0D0"
                   CornerRadius="8"
                   Padding="15"
                   IsVisible="{Binding IsProviderSelected}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding SelectedProvider.Name, StringFormat='Configure {0}'}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Label Text="{Binding Field1Label}"
                           FontSize="13" />
                    <Entry Text="{Binding Field1Value}"
                           Placeholder="{Binding Field1Label}"
                           IsPassword="True" />

                    <Label Text="{Binding Field2Label}"
                           FontSize="13" />
                    <Entry Text="{Binding Field2Value}"
                           Placeholder="{Binding Field2Label}"
                           IsPassword="True" />

                    <Label Text="Credentials are stored securely on device."
                           FontSize="11"
                           TextColor="Gray"
                           FontAttributes="Italic" />

                    <Button Text="Save Credentials"
                            Command="{Binding SaveCommand}"
                            BackgroundColor="#512BD4"
                            TextColor="White" />

                    <Button Text="Clear Credentials"
                            Command="{Binding ClearCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#512BD4"
                            BorderColor="#512BD4"
                            BorderWidth="1" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
