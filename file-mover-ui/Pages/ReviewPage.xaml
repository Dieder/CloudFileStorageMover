<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileMover.UI.Pages.ReviewPage"
             Title="Review Transfer">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">

            <!-- Summary Section -->
            <Label
                Text="Transfer Summary"
                FontSize="20"
                FontAttributes="Bold" />

            <!-- Source Section -->
            <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Source" FontSize="14" FontAttributes="Bold" />
                    <Label x:Name="SourceLabel" FontSize="12" TextColor="Gray" />
                    <Label x:Name="SourcePathLabel" FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Arrow -->
            <Label Text="↓" FontSize="24" HorizontalTextAlignment="Center" TextColor="#512BD4" />

            <!-- Destination Section -->
            <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Destination" FontSize="14" FontAttributes="Bold" />
                    <Label x:Name="DestinationLabel" FontSize="12" TextColor="Gray" />
                    <Label x:Name="DestinationPathLabel" FontSize="11" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Files Section -->
            <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Files to Transfer" FontSize="14" FontAttributes="Bold" />
                    <Label x:Name="FileCountLabel" FontSize="12" />
                    <Label x:Name="TotalSizeLabel" FontSize="12" />
                </VerticalStackLayout>
            </Frame>

            <!-- Transfer Mode Section -->
            <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Transfer Mode" FontSize="14" FontAttributes="Bold" />
                    <Label x:Name="ModeLabel" FontSize="12" />
                    <Label x:Name="ConnectionLabel" FontSize="11" TextColor="Gray" IsVisible="False" />
                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <StackLayout Spacing="10" Margin="0,15">
                <Button
                    x:Name="StartTransferBtn"
                    Text="Start Transfer"
                    Clicked="OnStartTransferClicked"
                    BackgroundColor="#12B886"
                    TextColor="White"
                    FontSize="16" />

                <Button
                    Text="Back to File Selection"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="#512BD4"
                    BorderColor="#512BD4"
                    BorderWidth="1" />
            </StackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
