<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileMover.UI.Pages.TransferModePage"
             Title="Transfer Mode">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">

            <Label
                Text="How do you want to transfer?"
                FontSize="18"
                FontAttributes="Bold" />

            <!-- Cloud-to-Cloud Transfer -->
            <Frame BorderColor="#E0E0E0"
                   CornerRadius="8"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <RadioButton x:Name="CloudToCloudRadio"
                                   Value="CloudToCloud"
                                   VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="Cloud-to-Cloud Transfer"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            <Label Text="Transfer directly between cloud storage providers"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- WiFi Direct Transfer -->
            <Frame BorderColor="#E0E0E0"
                   CornerRadius="8"
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <RadioButton x:Name="WiFiDirectRadio"
                                   Value="WiFiDirect"
                                   VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="WiFi Direct Transfer"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            <Label Text="Transfer files between devices over local WiFi"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Server/Client Mode (only for WiFi) -->
            <Frame BorderColor="#D0D0D0"
                   CornerRadius="8"
                   Padding="15"
                   HasShadow="True"
                   Margin="0,0,0,20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="WiFi Transfer Mode" FontSize="14" FontAttributes="Bold" />

                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <RadioButton x:Name="ServerRadio" Value="Server" VerticalOptions="Center" CheckedChanged="OnServerRadioCheckedChanged" />
                        <Label Text="Start as Server" VerticalOptions="Center" />
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <RadioButton x:Name="ClientRadio" Value="Client" VerticalOptions="Center" CheckedChanged="OnClientRadioCheckedChanged" />
                        <Label Text="Connect as Client" VerticalOptions="Center" />
                    </StackLayout>

                    <!-- QR Code Buttons -->
                    <StackLayout Orientation="Horizontal" Spacing="10" Margin="20,5,0,0">
                        <Button Text="Show QR Code"
                                x:Name="ShowQrBtn"
                                FontSize="12"
                                Padding="10,5"
                                Clicked="OnShowQrClicked"
                                IsVisible="False" />
                        <Button Text="Scan QR Code"
                                x:Name="ScanQrBtn"
                                FontSize="12"
                                Padding="10,5"
                                Clicked="OnScanQrClicked"
                                IsVisible="False" />
                    </StackLayout>

                    <!-- USB Pairing Option for Windows -->
                    <StackLayout Orientation="Horizontal" Spacing="10" Margin="20,5,0,0">
                        <Button Text="USB Pairing (Windows)"
                                x:Name="UsbPairingBtn"
                                FontSize="12"
                                Padding="10,5"
                                Clicked="OnUsbPairingClicked"
                                IsVisible="False" />
                    </StackLayout>

                    <Frame BorderColor="#F0F0F0" CornerRadius="6" Padding="10" Margin="20,10,0,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Server Address:" FontSize="11" FontAttributes="Bold" />
                            <Entry x:Name="ServerAddressEntry"
                                   Placeholder="IP Address"
                                   Keyboard="Default" />

                            <Label Text="Port:" FontSize="11" FontAttributes="Bold" Margin="0,10,0,0" />
                            <Entry x:Name="ServerPortEntry"
                                   Placeholder="5000"
                                   Keyboard="Numeric"
                                   Text="5000" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <StackLayout Spacing="10" Margin="0,10">
                <Button
                    Text="Continue"
                    Clicked="OnContinueClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White" />

                <Button
                    Text="Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="#512BD4"
                    BorderColor="#512BD4"
                    BorderWidth="1" />
            </StackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
