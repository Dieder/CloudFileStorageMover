<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileMover.UI.Pages.FileSelectionPage"
             Title="Select Files">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙"
                     Clicked="OnSettingsClicked"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Breadcrumb / Back Navigation -->
        <StackLayout Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="5"
                    Padding="15,8"
                    BackgroundColor="#EEEEEE">
            <Button Text="← Back"
                    x:Name="BackBtn"
                    FontSize="12"
                    Padding="8,4"
                    Clicked="OnBackToParentClicked"
                    IsVisible="{Binding CanGoBack}" />
            <Label Text="{Binding CurrentPath}"
                   FontSize="12"
                   TextColor="Gray"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   MaximumWidthRequest="400" />
        </StackLayout>

        <!-- File Type Filter Toolbar -->
        <StackLayout Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    Padding="15,10"
                    BackgroundColor="#F5F5F5">
            <Button Text="All"
                    x:Name="FilterAllBtn"
                    FontSize="12"
                    Padding="10,5"
                    Clicked="OnFilterAllClicked"
                    BackgroundColor="#512BD4" TextColor="White" />
            <Button Text="Images"
                    x:Name="FilterImagesBtn"
                    FontSize="12"
                    Padding="10,5"
                    Clicked="OnFilterImagesClicked"
                    BackgroundColor="Transparent" BorderColor="#512BD4" BorderWidth="1" TextColor="#512BD4" />
            <Button Text="Documents"
                    x:Name="FilterDocsBtn"
                    FontSize="12"
                    Padding="10,5"
                    Clicked="OnFilterDocsClicked"
                    BackgroundColor="Transparent" BorderColor="#512BD4" BorderWidth="1" TextColor="#512BD4" />
            <Button Text="Videos"
                    x:Name="FilterVideosBtn"
                    FontSize="12"
                    Padding="10,5"
                    Clicked="OnFilterVideosClicked"
                    BackgroundColor="Transparent" BorderColor="#512BD4" BorderWidth="1" TextColor="#512BD4" />
        </StackLayout>

        <!-- Selection Toolbar -->
        <StackLayout Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="5"
                    Padding="15,5">
            <Button Text="Select All"
                    FontSize="12"
                    Padding="10,5"
                    Clicked="OnSelectAllClicked" />
            <Button Text="Deselect All"
                    FontSize="12"
                    Padding="10,5"
                    Clicked="OnDeselectAllClicked" />
            <Button Text="📁 Pick Folder"
                    FontSize="12"
                    Padding="10,5"
                    Clicked="OnPickFolderClicked" />
            <Button Text="📷 Camera"
                    FontSize="12"
                    Padding="10,5"
                    Clicked="OnCameraClicked" />
            <Label Text="{Binding SelectedFiles.Count, StringFormat='({0} selected)'}"
                   VerticalOptions="Center"
                   FontSize="12"
                   TextColor="Gray"
                   Margin="10,0,0,0" />
        </StackLayout>

        <!-- Main Content: Files List + Preview Pane -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <!-- Files List -->
            <CollectionView ItemsSource="{Binding Files}"
                           SelectionMode="Single"
                           SelectedItem="{Binding SelectedFile}"
                           SelectionChanged="OnFileSelectionChanged"
                           Margin="0,0,0,15">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="15,10" Spacing="5">
                            <!-- File Item Row -->
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <CheckBox
                                    IsChecked="{Binding IsSelected}"
                                    VerticalOptions="Center"
                                    Margin="0,0,10,0" />

                                <VerticalStackLayout Spacing="3" HorizontalOptions="FillAndExpand">
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold" />
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <Label Text="{Binding SizeDisplay}"
                                               FontSize="11"
                                               TextColor="Gray" />
                                        <Label Text="{Binding Modified, StringFormat='Modified: {0:g}'}"
                                               FontSize="11"
                                               TextColor="Gray" />
                                    </StackLayout>
                                </VerticalStackLayout>

                                <Label x:Name="FolderIcon"
                                       Text="📁"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsFolder}" />
                            </StackLayout>

                            <BoxView Color="#E0E0E0" HeightRequest="1" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Preview Pane -->
            <Frame Grid.Column="1"
                   WidthRequest="280"
                   BorderColor="#E0E0E0"
                   CornerRadius="8"
                   Margin="0,0,10,15"
                   Padding="10"
                   IsVisible="{Binding SelectedFile, Converter={StaticResource NotNullToBoolConverter}}">
                <ScrollView>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Preview"
                               FontSize="14"
                               FontAttributes="Bold" />

                        <!-- Preview Content -->
                        <Frame BorderColor="#F0F0F0"
                               CornerRadius="4"
                               HeightRequest="160"
                               Padding="0"
                               BackgroundColor="#FAFAFA">
                            <Image x:Name="PreviewImage"
                                   Aspect="AspectFit"
                                   IsVisible="False" />
                            <Label x:Name="PreviewPlaceholder"
                                   Text="No preview available"
                                   FontSize="11"
                                   TextColor="Gray"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Frame>

                        <!-- File Info -->
                        <Label x:Name="PreviewFileName"
                               FontSize="12"
                               FontAttributes="Bold" />
                        <Label x:Name="PreviewFileSize"
                               FontSize="10"
                               TextColor="Gray" />
                        <Label x:Name="PreviewFileDate"
                               FontSize="10"
                               TextColor="Gray" />

                        <!-- Image EXIF Metadata -->
                        <Frame BorderColor="#F0F0F0"
                               CornerRadius="4"
                               Padding="8"
                               x:Name="ExifMetadataPanel"
                               IsVisible="False">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="EXIF Metadata"
                                       FontSize="11"
                                       FontAttributes="Bold" />
                                <Label x:Name="ExifCamera"
                                       FontSize="10"
                                       TextColor="Gray" />
                                <Label x:Name="ExifDate"
                                       FontSize="10"
                                       TextColor="Gray" />
                                <Label x:Name="ExifDimensions"
                                       FontSize="10"
                                       TextColor="Gray" />
                                <Label x:Name="ExifAperture"
                                       FontSize="10"
                                       TextColor="Gray" />
                                <Label x:Name="ExifExposure"
                                       FontSize="10"
                                       TextColor="Gray" />
                                <Label x:Name="ExifIso"
                                       FontSize="10"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Edit Image Button -->
                        <Button Text="✏️ Edit Image"
                                x:Name="EditImageBtn"
                                FontSize="11"
                                Padding="8,4"
                                Clicked="OnEditImageClicked"
                                IsVisible="False" />
                    </VerticalStackLayout>
                </ScrollView>
            </Frame>
        </Grid>

        <!-- Bottom Buttons -->
        <StackLayout Grid.Row="4" Spacing="10" Padding="15" Margin="0,10,0,0">
            <Button Text="Continue with Selected Files"
                    Clicked="OnContinueClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White" />

            <Button Text="Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="#512BD4"
                    BorderColor="#512BD4"
                    BorderWidth="1" />
        </StackLayout>

        <!-- Loading Indicator -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          Color="#512BD4"
                          Margin="0,10" />

    </Grid>

</ContentPage>
