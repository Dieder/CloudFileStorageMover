<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileMover.UI.Pages.ModeSelectionPage"
             Title="File Mover">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25" VerticalOptions="Center">

            <Label Text="File Mover"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label Text="Choose how you want to transfer files"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20" />

            <Frame BorderColor="#E0E0E0"
                   CornerRadius="12"
                   Padding="20"
                   HasShadow="True"
                   BackgroundColor="#FAFAFA">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Server Mode"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Browse files on this device and send them to another device"
                           FontSize="13"
                           TextColor="Gray" />
                    <Button Text="Start as Server"
                            FontSize="16"
                            Padding="15,12"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Clicked="OnServerClicked"
                            BackgroundColor="#512BD4"
                            TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="#E0E0E0"
                   CornerRadius="12"
                   Padding="20"
                   HasShadow="True"
                   BackgroundColor="#FAFAFA">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Client Mode"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Connect to a server device and receive files from it"
                           FontSize="13"
                           TextColor="Gray" />
                    <Button Text="Connect as Client"
                            FontSize="16"
                            Padding="15,12"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Clicked="OnClientClicked"
                            BackgroundColor="#E8E8E8"
                            TextColor="#333333" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
