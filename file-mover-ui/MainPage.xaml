<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileMover.UI.MainPage"
             Title="File Mover">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15"
            VerticalOptions="StartAndExpand">

            <!-- Header -->
            <Label
                Text="File Mover"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                Margin="0,20,0,10" />

            <Label
                Text="Move files between cloud storage and devices"
                FontSize="16"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <!-- New Transfer Button -->
            <Button
                x:Name="NewTransferBtn"
                Text="Start New Transfer"
                FontSize="18"
                Padding="20,15"
                CornerRadius="8"
                Clicked="OnNewTransferClicked"
                BackgroundColor="#512BD4"
                TextColor="White"
                Margin="0,20,0,0" />

            <!-- Features Section -->
            <Label
                Text="Features"
                FontSize="18"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="☁️" FontSize="20" VerticalOptions="Center" />
                        <Label Text="Cloud-to-Cloud Transfers" VerticalOptions="Center" />
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="📱" FontSize="20" VerticalOptions="Center" />
                        <Label Text="WiFi Direct Transfer" VerticalOptions="Center" />
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="📊" FontSize="20" VerticalOptions="Center" />
                        <Label Text="Real-time Progress" VerticalOptions="Center" />
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Recent Transfers Section -->
            <Label
                Text="Recent Transfers"
                FontSize="18"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Frame BorderColor="#E0E0E0"
                   CornerRadius="8"
                   HasShadow="True"
                   Padding="15">

                <VerticalStackLayout Spacing="10">
                    <CollectionView x:Name="RecentTransfersCollection"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="10" Spacing="5">
                                    <Label Text="{Binding CurrentFile, StringFormat='File: {0}'}"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                    <ProgressBar Progress="{Binding ProgressPercentage, 
                                                 Converter={StaticResource DoubleToProgressConverter}}"
                                                 HeightRequest="4" />
                                    <Label Text="{Binding Status}"
                                           FontSize="11"
                                           TextColor="Gray" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button
                        Text="View All History"
                        FontSize="14"
                        Clicked="OnViewHistoryClicked" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
